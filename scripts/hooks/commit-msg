#!/usr/bin/env sh
# File: scripts/hooks/commit-msg
# Purpose: git commit-msg hook — enforce the Protofire commit message rules.
#   Runs on every `git commit` (install once with `make install-hooks`); the
#   same checks run in CI for every pull request (see .github/workflows/ci.yml).
#   See CONTRIBUTING.md → "Commit Message Guidelines" for the rationale.

set -eu

if [ "$#" -ne 1 ]; then
    echo "commit-msg: usage: $0 <commit-message-file>" >&2
    exit 1
fi

msg_file="$1"
[ -f "$msg_file" ] || { echo "commit-msg: not a file: $msg_file" >&2; exit 1; }

# Strip the editor template's comment block (lines whose first non-space char
# is '#').  `git commit -m` messages never contain those, so this is a no-op
# for scripted commits.
cleaned="$(sed '/^[[:space:]]*#/d' "$msg_file")"

subject="$(printf '%s\n' "$cleaned" | sed -n '1p')"

fail() {
    echo "commit-msg: rejected — $1" >&2
    echo "  See CONTRIBUTING.md -> 'Commit Message Guidelines'." >&2
    exit 1
}

# 1. Subject line is present.
[ -n "$subject" ] || fail "empty subject line"

# 2. No leading/trailing whitespace on the subject.
trimmed="$(printf '%s' "$subject" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
[ "$subject" = "$trimmed" ] || fail "subject must not have leading/trailing whitespace"

# 3. Merge/Revert subjects are generated by git — exempt.
case "$subject" in
    "Merge "*|"Revert "*) exit 0 ;;
esac

# 4. No trailing period.
case "$subject" in
    *.) fail "subject must not end with a period" ;;
esac

# 5. Reject the useless generic one-word subjects (Linus's pet peeves).
case "$subject" in
    update|Update|fix|Fix|fixup|cleanup|Cleanup|typo|wip|WIP|Wip)
        fail "subject '$subject' carries no information — describe the change" ;;
esac

# 6. Subject length <= 72 characters.  Only enforced for ASCII subjects;
#    non-ASCII subjects (e.g. 简体中文) are exempt from the byte-based limit.
if printf '%s' "$subject" | LC_ALL=C grep -q '[^ -~]'; then
    :
else
    slen="$(printf '%s' "$subject" | wc -c)"
    [ "$slen" -le 72 ] || fail "subject too long ($slen > 72 chars)"
fi

# 7. Body lines wrapped at 72 characters.  awk counts characters, so CJK text
#    is measured fairly.  Lines that look like git trailers
#    ("Co-authored-by: ...", "Signed-off-by: ...", ...) are exempt — trailers
#    stay on a single line and are produced by tooling, not wrapped by hand.
if printf '%s\n' "$cleaned" | \
    awk 'NR > 1 && /./ && $0 !~ /^[[:alpha:]][[:alnum:]_-]*:/ && length($0) > 72 {
            print "  body line " NR " is " length($0) " chars (>72)" > "/dev/stderr"
            bad = 1
         }
         END { exit bad }'
then
    :
else
    fail "body has lines over 72 chars (see stderr)"
fi

# 8. Every commit carries the primary developer's Signed-off-by (DCO).  This
#    is the one mandatory attribution trailer: people own the work, tools only
#    assist (see CONTRIBUTING.md -> 'Commit Message Guidelines').
case "$cleaned" in
    *"Signed-off-by:"*) : ;;
    *) fail "missing Signed-off-by trailer — the primary developer must sign (git commit -s)" ;;
esac

exit 0
